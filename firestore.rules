rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test doc
    match /test/connection {
      allow read, write: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone signed in can read user/provider info (public directory of student sellers & profiles)
      allow read: if true;
      // Users can only create or update their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Products / Services listings
    match /products/{productId} {
      // Anyone can browse products and services
      allow read: if true;
      // Only signed in users can create a product listing, and sellerUid must match auth uid
      allow create: if isSignedIn() && request.resource.data.sellerUid == request.auth.uid;
      // Only the seller who created the product can update or delete it
      allow update, delete: if isSignedIn() && resource.data.sellerUid == request.auth.uid;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      // Only signed in users can submit a review with their own reviewerUid
      allow create: if isSignedIn() && request.resource.data.reviewerUid == request.auth.uid;
      // Reviewers can delete or update their own reviews
      allow update, delete: if isSignedIn() && resource.data.reviewerUid == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || request.auth.token.admin == true);
      allow create: if isSignedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.customerUid == request.auth.uid;
    }
  }
}
